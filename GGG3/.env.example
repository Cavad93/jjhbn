# =============================================================================
# BINANCE TRADING BOT - ENVIRONMENT VARIABLES
# =============================================================================
#
# Инструкция:
# 1. Скопируйте этот файл как .env:
#    Windows: copy .env.example .env
#    Linux:   cp .env.example .env
#
# 2. Оставьте как есть для paper trading (рекомендуется!)
#    ИЛИ заполните API ключи для live trading (ОСТОРОЖНО!)
#
# 3. ВАЖНО: Файл .env уже добавлен в .gitignore - не коммитьте его!
#
# =============================================================================

# -----------------------------------------------------------------------------
# ⚙️ РЕЖИМ РАБОТЫ (ГЛАВНАЯ НАСТРОЙКА)
# -----------------------------------------------------------------------------
# Paper trading mode (true/false)
# true  - ВИРТУАЛЬНЫЕ деньги, реальные данные рынка ✅ РЕКОМЕНДУЕТСЯ
# false - РЕАЛЬНАЯ торговля с реальными деньгами ⚠️ ОСТОРОЖНО!
PAPER_TRADING_MODE=true

# Начальный баланс для paper trading (USDT)
PAPER_INITIAL_BALANCE=10000

# -----------------------------------------------------------------------------
# 🔑 BINANCE API КЛЮЧИ (НЕ НУЖНЫ ДЛЯ PAPER TRADING!)
# -----------------------------------------------------------------------------
# ⚠️ ВНИМАНИЕ:
# Для paper trading API ключи НЕ ТРЕБУЮТСЯ!
# Бот использует ПУБЛИЧНЫЕ API Binance для получения реальных данных рынка
# и ведет виртуальную торговлю без доступа к вашему аккаунту.
#
# API ключи нужны ТОЛЬКО для LIVE trading (реальная торговля):
# - Получить: https://www.binance.com/en/my/settings/api-management
# - Включите только "Spot & Margin Trading" и "Futures"
# - НЕ включайте "Enable Withdrawals"
# - Используйте IP Whitelist для безопасности
#
# Для paper trading оставьте эти поля пустыми:
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Использовать testnet? (true/false)
# ⚠️ ВАЖНО: Для paper trading установите false для РЕАЛЬНЫХ данных рынка!
# true  - testnet (тестовые данные, не реальный рынок)
# false - mainnet (РЕАЛЬНЫЕ данные рынка) ✅ ИСПОЛЬЗУЙТЕ ДЛЯ PAPER TRADING
USE_TESTNET=false

# -----------------------------------------------------------------------------
# 📱 TELEGRAM УВЕДОМЛЕНИЯ (опционально)
# -----------------------------------------------------------------------------
# Как получить:
# 1. Создайте бота: https://t.me/BotFather -> /newbot
# 2. Получите токен (формат: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# 3. Получите Chat ID: https://t.me/userinfobot -> /start
# 4. Для группового чата: добавьте бота в группу, получите Group Chat ID
# 5. Вставьте значения ниже
#
# Для работы БЕЗ Telegram оставьте поля пустыми:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ID группы для отправки уведомлений (опционально)
TELEGRAM_GROUP_CHAT_ID=
# ID пользователя, который может отправлять команды боту (по умолчанию: 939056216)
TELEGRAM_ALLOWED_USER_ID=939056216

# -----------------------------------------------------------------------------
# 🤖 ANTHROPIC CLAUDE API (опционально)
# -----------------------------------------------------------------------------
# Используется для:
# 1. 🧠 AI Trading Assistant (Claude Sonnet 4.5)
#    - Интерактивный чат с ботом через Telegram
#    - Анализ решений и диагностика
#    - AI Status с умными инсайтами
#    - Стоимость: ~$10-20/месяц (зависит от использования)
#
# 2. 📊 Haiku 4.5 Fundamental Analysis
#    - Фундаментальный анализ монет
#    - Стоимость: ~$6-12/месяц при 20 монет × 6 раз/день
#
# Как получить:
# 1. Зарегистрируйтесь: https://console.anthropic.com/
# 2. Создайте API ключ в Settings -> API Keys
# 3. Вставьте значение ниже
#
# Для работы БЕЗ AI оставьте поле пустым:
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# 🎯 ТОРГОВЫЕ ПАРАМЕТРЫ (опционально)
# -----------------------------------------------------------------------------
# Эти параметры можно оставить по умолчанию
# или настроить под вашу стратегию

# Максимальное количество одновременных позиций
# MAX_POSITIONS=10

# Минимальный размер позиции (USDT)
# MIN_POSITION_SIZE_USDT=15

# Максимальный размер позиции (USDT)
# MAX_POSITION_SIZE_USDT=200

# Плечо (leverage) - для paper trading всегда 1x
# LEVERAGE=1

# -----------------------------------------------------------------------------
# 📊 ЛОГИРОВАНИЕ
# -----------------------------------------------------------------------------
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Путь к файлу логов
# LOG_FILE=logs/binance_bot.log

# -----------------------------------------------------------------------------
# 🗄️ БАЗА ДАННЫХ (для Smart Data Collector, опционально)
# -----------------------------------------------------------------------------
# PostgreSQL connection
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=binance_trading
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# =============================================================================
# 📝 ИТОГО ДЛЯ PAPER TRADING:
# =============================================================================
# Обязательные настройки:
# ✅ PAPER_TRADING_MODE=true
# ✅ USE_TESTNET=false (для реальных данных рынка!)
#
# Необязательные:
# - BINANCE_API_KEY (оставьте пустым)
# - BINANCE_SECRET_KEY (оставьте пустым)
# - TELEGRAM_BOT_TOKEN (оставьте пустым или настройте для уведомлений)
# - TELEGRAM_CHAT_ID (оставьте пустым или настройте)
#
# Всё! Бот готов к работе в режиме paper trading с реальными данными рынка! 🚀
# =============================================================================
